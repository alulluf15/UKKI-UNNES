{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Inspect Git repository",
			"type": "shell",
			"command": "git",
			"args": [
				"status",
				"--short",
				"--branch"
			],
			"isBackground": false,
			"problemMatcher": []
		},
		{
			"label": "Locate Git tools",
			"type": "shell",
			"command": "cmd.exe",
			"args": [
				"/c",
				"where git && where curl"
			],
			"isBackground": false,
			"problemMatcher": []
		}
	]
}